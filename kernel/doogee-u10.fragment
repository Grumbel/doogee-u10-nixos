# SPDX-License-Identifier: GPL-2.0-or-later
# Changes to rk3562deb's rockchip_linux_defconfig. The first part repeats
# what rk3562deb's build.sh sets with scripts/config (Panfrost GPU stack),
# the second part is what NixOS needs on top.
#
# kernel/doogee-u10.config is generated from defconfig + this file:
#   nix build .#kernelConfig && cp result kernel/doogee-u10.config
# The build fails if an option here doesn't end up in the config (usually
# a missing dependency).

# --- From rk3562deb build.sh ------------------------------------------------

# GCC 14 + current binutils fail at the vmlinux link with
# patchable-function-entry sections from dynamic ftrace
# CONFIG_DYNAMIC_FTRACE is not set

# Seekwave SWT6621S / EA6621Q Wi-Fi and Bluetooth instead of the Broadcom path
# CONFIG_BCMDHD is not set
# CONFIG_AP6XXX is not set
# CONFIG_WL_ROCKCHIP is not set
CONFIG_SEEKWAVE_BSP_DRIVERS=y
CONFIG_SKW_SDIOHAL=y
CONFIG_SKW_BSP_UCOM=y
CONFIG_SKW_BSP_BOOT=y
CONFIG_WLAN_VENDOR_SEEKWAVE=y
CONFIG_SKW_VENDOR=y
CONFIG_SKW_DFS_MASTER=y
CONFIG_SKW_BT=m
# Wi-Fi firmware, built in (from the rk3562deb overlay, copied to firmware/)
CONFIG_EXTRA_FIRMWARE="RAM_RW_KERNEL_DRAM.bin ROM_EXEC_KERNEL_IRAM.bin EA6621Q_SEEKWAVE_R00005.bin"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"

# Accelerometers (Rockchip sensor framework, /dev/mma8452_daemon)
CONFIG_SENSOR_DEVICE=y
CONFIG_GSENSOR_DEVICE=y
CONFIG_GS_SC7A20=y
CONFIG_GS_DA223=y
CONFIG_GS_DA228E=y

# Audio (RK817 codec)
CONFIG_SND_CTL_FAST_LOOKUP=y
CONFIG_SND_SOC_ROCKCHIP_ASRC=y
CONFIG_SND_SOC_ROCKCHIP_DLP=y
CONFIG_SND_SOC_ROCKCHIP_DLP_PCM=y
CONFIG_SND_SOC_ROCKCHIP_MULTI_DAIS=y
CONFIG_SND_SOC_ROCKCHIP_PDM_V2=y
CONFIG_SND_SOC_ROCKCHIP_TRCM=y

# Console on the panel
CONFIG_FRAMEBUFFER_CONSOLE=y

# Panfrost instead of the vendor Mali (bifrost) driver
CONFIG_DRM_PANFROST=y
# CONFIG_MALI_BIFROST is not set

# Containers, binfmt_misc. build.sh also sets NETFILTER_XT_MATCH_IPVS,
# which needs IP_VS, and the NAT options, which need NF_CONNTRACK
CONFIG_BINFMT_MISC=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_BLK_CGROUP=y
CONFIG_POSIX_MQUEUE=y
CONFIG_OVERLAY_FS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# --- NixOS ------------------------------------------------------------------

# systemd
CONFIG_AUTOFS_FS=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_TMPFS_XATTR=y
# The NixOS initrd is zstd-compressed
CONFIG_RD_ZSTD=y
# zram swap (zramSwap.algorithm default)
CONFIG_CRYPTO_ZSTD=y

# nftables (networking.nftables / firewall)
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y

# USB networking to a PC (g_ether on the USB-C port)
CONFIG_USB_ETH=m
CONFIG_USB_ETH_RNDIS=y

# Vendor code has warnings
# CONFIG_WERROR is not set
